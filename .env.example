# Neon Postgres — pooled connection, used by the app at runtime
DATABASE_URL=
# Neon Postgres — direct connection, used by Prisma Migrate
DIRECT_URL=

# Neon Auth — same URL in both; NEXT_PUBLIC_ variant is exposed to the client
NEON_AUTH_BASE_URL=
NEXT_PUBLIC_NEON_AUTH_URL=
# Neon Auth — signs session cookies, generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=
