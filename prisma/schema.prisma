generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Identity/accounts are owned by Neon Auth, not Prisma — its `user` table
// lives outside this schema. userId fields below are plain references to
// that external id, not Prisma relations.
model Run {
  id            String       @id @default(cuid())
  userId        String
  difficulty    String
  startedAt     DateTime     @default(now())
  endedAt       DateTime?
  endBankroll   Int?
  peakBankroll  Int          @default(1000)
  floorsReached Int          @default(0)
  gamesPlayed   Int          @default(0)
  victory       Boolean      @default(false)
  seed          String
  diceWinSums   Int[]
  diceLossSums  Int[]
  results       GameResult[]

  @@index([userId])
}

model GameResult {
  id         String   @id @default(cuid())
  runId      String
  run        Run      @relation(fields: [runId], references: [id])
  game       String
  floor      Int
  betAmount  Int
  payout     Int
  outcome    String
  multiplier Float?
  playedAt   DateTime @default(now())
}

model UserCosmetic {
  id         String   @id @default(cuid())
  userId     String
  type       String
  itemId     String
  unlockedAt DateTime @default(now())
}

// Puzzle mode — see .md/PUZZLE_MODE_SPEC.md §7.
// Playing never requires an account; creating a challenge or submitting a
// leaderboard score does, so identity here is always a Neon Auth user id.
model Challenge {
  id             String             @id @default(cuid())
  date           String? // null for custom, "2026-08-18" for daily
  objective      String // "bankroll" | "speedrun"
  seed           String
  games          String[] // 5 GameNames
  scenarios      Json? // resolved scenario set for this challenge
  startBankroll  Int
  betCap         Int? // Bankroll Attack
  targetBankroll Int? // Speedrun
  name           String? // custom challenges only
  visibility     String             @default("private") // "public" | "private"
  shareCode      String             @unique
  createdById    String? // Neon Auth user id; null for daily (system-generated)
  playCount      Int                @default(0)
  createdAt      DateTime           @default(now())
  entries        LeaderboardEntry[]
}

model LeaderboardEntry {
  id          String    @id @default(cuid())
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id])
  userId      String // Neon Auth user id — submitting a score requires signing in
  displayName String? // per-challenge override; defaults to the account's name
  score       Int // endBankroll (Bankroll Attack) or betsUsed (Speedrun)
  betsUsed    Int
  endBankroll Int
  completed   Boolean // did the player reach the objective (Speedrun) / finish the cap (Bankroll Attack)
  completedAt DateTime  @default(now())
}

// One row per signed-in user and synced store (see SYNCED_STORE_KEYS):
// the store's persisted localStorage value, so progress follows the account
// across devices. Written in batches by components/account-sync.tsx.
model UserState {
  userId    String // Neon Auth user id
  key       String // which store, see SYNCED_STORE_KEYS in lib/sync/stores.ts
  data      Json // the store's persisted { state, version }
  changedAt DateTime // when the player last changed it (client clock); newer wins
  updatedAt DateTime @updatedAt

  @@id([userId, key])
}

// Community challenges (Challenges mode, see .md/CHALLENGES.md): made by signed-in
// players, playable by anyone. `tries` counts every started attempt; the best
// completed result is kept per signed-in player in CommunityChallengeScore.
model CommunityChallenge {
  id            String                   @id @default(cuid())
  name          String
  theme         String
  description   String                   @default("")
  minBet        Int
  games         Json // [{ game: GameName, bets: number }], 2–6 games, 1–6 bets each
  createdById   String // Neon Auth user id
  createdByName String
  tries         Int                      @default(0)
  createdAt     DateTime                 @default(now())
  scores        CommunityChallengeScore[]

  @@index([createdAt])
}

model CommunityChallengeScore {
  challengeId String
  challenge   CommunityChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  userId      String // Neon Auth user id
  displayName String
  best        Float // bankrolls can pass the 32-bit Int range
  updatedAt   DateTime           @updatedAt

  @@id([challengeId, userId])
  @@index([challengeId, best])
}
